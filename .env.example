# Discord bot token (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Discord application/client ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=

# Guild ID for fast command deployment during development. Omit (or leave empty) to
# deploy commands globally instead.
DISCORD_DEV_GUILD_ID=

# Discord user ID allowed to run /admin commands
BOT_OWNER_ID=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
